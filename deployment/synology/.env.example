# Immich on BlackholeNAS — copy to .env on the NAS (do not commit real .env)

# Photo library on HDD (volume1) — NOT the 1TB SSD
UPLOAD_LOCATION=/volume1/data/immich/library

# Synology Photos (indexed read-only as External Library)
PHOTOS_BACKUP_LOCATION=/volume1/homes/faizan/Photos

# Postgres on SSD
DB_DATA_LOCATION=/volume2/docker-ssd/immich/postgres

TZ=Asia/Qatar

# Pin Immich release tag
IMMICH_VERSION=v3.2.0

# A-Za-z0-9 only
DB_PASSWORD=CHANGE_ME_TO_RANDOM_PASSWORD

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
