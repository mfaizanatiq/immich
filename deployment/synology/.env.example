# Copy to .env on the NAS and edit. Do not commit a real .env.

# Photo library (large HDD volume)
UPLOAD_LOCATION=/volume1/photo/immich

# Postgres data (prefer SSD)
DB_DATA_LOCATION=/volume2/docker-ssd/immich/postgres

# Asia/Qatar — change if needed
TZ=Asia/Qatar

# Your fork image tag (built by GitHub Actions on branch `mfa`)
IMMICH_VERSION=mfa

# Change this before first start (A-Za-z0-9 only)
DB_PASSWORD=CHANGE_ME_TO_RANDOM_PASSWORD

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
